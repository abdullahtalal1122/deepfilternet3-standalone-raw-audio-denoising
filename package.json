{
  "name": "deepfilter-standalone",
  "version": "1.0.0",
  "description": "Standalone DeepFilterNet3 audio denoiser - direct buffer processing without AudioWorklet",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/df3"
  ],
  "scripts": {
      "build": "tsc",
      "prepublishOnly": "npm run build"
  },
  "keywords": [
    "deepfilter",
    "noise-reduction",
    "audio",
    "denoising",
    "wasm"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
    "dependencies": {}
}
